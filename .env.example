# ── Bloomy Studio — variables d'environnement ────────────────────────────────
# Copier en .env.local pour le développement. AUCUNE valeur réelle dans Git.
# En production (Firebase App Hosting), déclarer via apphosting.yaml + Secret Manager.

# URL canonique publique du site (sans slash final).
# Sert aux canonicals, sitemap, Open Graph et JSON-LD.
NEXT_PUBLIC_SITE_URL=https://studio.bloomy.one

# Mesure d'audience GA4 — FACULTATIF.
# Sans cette variable, aucun script analytics n'est jamais chargé.
# Même avec elle, rien ne se charge sans consentement explicite du visiteur.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Stockage des leads (serveur uniquement) ──────────────────────────────────
# Sur App Hosting, les Application Default Credentials suffisent : ne rien
# configurer ici. En local, pour tester l'écriture Firestore, coller le JSON
# du compte de service (une seule ligne) — SECRET, jamais commité.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Notifications e-mail (serveur uniquement) — FACULTATIF ───────────────────
# Sans ces variables, les leads sont stockés mais aucun e-mail n'est envoyé.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# LEADS_FROM_EMAIL="Bloomy Studio <notifications@studio.bloomy.one>"
