rules_version = '2';

// Le site n'utilise JAMAIS le SDK client Firestore : les leads sont écrits
// exclusivement côté serveur via le SDK Admin (qui contourne ces règles).
// Tout accès client est donc refusé — ne pas assouplir pour « déboguer ».
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
